# Sovereign deploy — copy keys you need into .env.local (never commit .env.local)
#
# --- Local Kubo (preferred zero-trust path) ---
# Install: npm install -g --allow-scripts=kubo kubo
# Init once: ipfs init
# Run daemon: ipfs daemon
# Deploy: npm run deploy:local   (or: npm run ship -- --ipfs-local)
IPFS_API=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8080
# Optional: publish IPNS under this key (default key is "self")
# IPNS_KEY_NAME=self
# Optional: absolute path to ipfs.exe if not on PATH
# IPFS_BIN=

# --- Pinata (optional public mirror / cloud pin) ---
# Pinata: app.pinata.cloud → API Keys → New Key (pinFileToIPFS + publishIpns)
PINATA_JWT=

# Dedicated gateway (Gateways page). Use custom domain when wired.
PINATA_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud

# Managed IPNS key name (Pinata → IPNS). Stable pointer; update on each deploy.
PINATA_IPNS_NAME=

# Optional pin label in Pinata dashboard
PINATA_PIN_NAME=transition-insight-out

# --- Solana JSON-RPC (optional) ---
# Default in .env.development / .env.production is PublicNode (browser CORS, epoch/slot only).
# Paste a Helius / QuickNode / validator URL in Cord compose instead of committing a keyed URL.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Bake into the *next* build after first successful pin (scripts print these):
# NEXT_PUBLIC_IPFS_CID=
# NEXT_PUBLIC_IPFS_GATEWAY=http://127.0.0.1:8080
# NEXT_PUBLIC_IPNS_NAME=
