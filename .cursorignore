# Secrets / local credentials — never index into Cursor context
# .env.local is gitignored (not GitHub) but visible in Cursor so keys can be edited.
.env
.env.*.local
.env.production.local
.env.development.local
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
**/credentials.json
**/service-account*.json

# Local sovereign / tooling state
.sovereign/
.tools/
.snapshots/
scripts/nightly-backup.config.json

# Dependencies & build artifacts (noise + supply-chain surface)
node_modules/
.next/
out/
semantic-graph/
data/imports/
GenX.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.obsidian/

# Large / non-source dumps
*.zip
*.tar
*.tar.gz
*.log
npm-debug.log*
