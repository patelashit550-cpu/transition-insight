# Blank form. Copy to .env.local and put your keys there.
# .env.local never goes to GitHub. Do not put keys in this file.

# https://developers.jup.ag/portal
JUPITER_API_KEY=

# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# https://arena.colosseum.org/copilot
COLOSSEUM_COPILOT_PAT=

# https://docs.vybenetwork.com/docs/getting-started
# MCP tools/list is public; tools/call needs OAuth. This key is for REST execute-request.
VYBE_API_KEY=

# Must be the secret for 6qr7vtip1h2wD7ktLZQYa7XvnJtjnLLeGFF8a6EPtLKT
# (same as NEXT_PUBLIC_SOLANA_WALLET_ADDRESS). Never NEXT_PUBLIC_*.
# SOLANA_SIGNING_KEY=
# SOLANA_KEYPAIR_PATH=

# Pinata dedicated gateway (public gateway.pinata.cloud refuses HTML).
# PINATA_JWT=
# PINATA_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud
# NEXT_PUBLIC_IPFS_CID=

# Carta ask (home Bento 3). Local `npm run dev` only — the static export
# has no App Router. Never NEXT_PUBLIC_* for these keys.
# OpenAI-compatible chat (default model gpt-4o-mini):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Local Ollama:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2:3b
#
# Optional open-web enrichment (Brave Search). Without the flag+key the UI
# reports the web as unavailable; the corpus filter still runs.
# CARTA_ASK_WEB_SEARCH=1
# BRAVE_SEARCH_API_KEY=

# Local Kubo / IPFS Desktop. The defaults work when the desktop app or
# `ipfs daemon` uses its standard API and gateway ports.
# IPFS_BIN=C:\path\to\ipfs.exe
# IPFS_API=/ip4/127.0.0.1/tcp/5001
# IPFS_GATEWAY=http://127.0.0.1:8080
# IPNS_KEY_NAME=self
