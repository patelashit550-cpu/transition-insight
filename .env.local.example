# Visible template. Cursor hides the real .env.local on purpose (gitignored + .cursorignore).
# Create it on the laptop:
#   npm run env:local
# Then open .env.local in Explorer or Notepad and paste the keys. Never commit .env.local.
# Never put these in NEXT_PUBLIC_* — they must not ship in the static site.

# https://developers.jup.ag/portal
JUPITER_API_KEY=

# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# Optional if PublicNode rate-limits the Solana probe:
# SOLANA_RPC_URL=
