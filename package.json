{
  "name": "planet-iii-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:local": "node scripts/with-content-tier.mjs local node ./node_modules/next/dist/bin/next dev",
    "dev:global": "node scripts/with-content-tier.mjs global node ./node_modules/next/dist/bin/next dev",
    "dev:preprod": "node scripts/with-content-tier.mjs preprod node ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/sync-published-assets.mjs && node scripts/generate-corpus-graph.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node scripts/with-stashed-app-api.mjs node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "build:global": "node scripts/sync-published-assets.mjs && node scripts/generate-corpus-graph.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node scripts/with-content-tier.mjs global node scripts/with-stashed-app-api.mjs node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "build:preprod": "node scripts/sync-published-assets.mjs && node scripts/generate-corpus-graph.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node scripts/with-content-tier.mjs preprod node scripts/with-stashed-app-api.mjs node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "start": "next start",
    "lint": "eslint .",
    "content:sign": "node scripts/sign-content.mjs",
    "content:verify": "node scripts/sign-content.mjs --verify",
    "sync:assets": "node scripts/sync-published-assets.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:sitemap:live": "node scripts/verify-sitemap.mjs --live=https://ashitmilne.xyz",
    "scan:agent-ready": "node scripts/scan-agent-ready.mjs https://ashitmilne.xyz",
    "audit:perimeter": "node scripts/audit-perimeter.mjs",
    "audit:perimeter:export": "node scripts/audit-perimeter.mjs --export",
    "audit:github": "node scripts/audit-perimeter.mjs --github",
    "process:bento-emblems": "python scripts/process-bento-emblems.py",
    "content:attest": "node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs",
    "ship": "node scripts/ship.mjs",
    "pinata:upload": "node scripts/pinata-upload-dir.mjs",
    "kubo:upload": "node scripts/kubo-upload-dir.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "deploy:local:upload": "node scripts/deploy-local.mjs --upload-only",
    "deploy:sovereign": "node scripts/deploy-sovereign.mjs",
    "deploy:sovereign:upload": "node scripts/deploy-sovereign.mjs --upload-only",
    "pinata:cleanup": "node scripts/pinata-cleanup-pins.mjs",
    "tags:auto": "node scripts/auto-tag-essays.mjs",
    "tags:write": "node scripts/auto-tag-essays.mjs --write",
    "lexica:graph": "node scripts/generate-lexica-graph.mjs",
    "lexica:watch": "node --watch-path=ontology scripts/generate-lexica-graph.mjs",
    "graph:published": "node scripts/generate-corpus-graph.mjs",
    "graph:watch": "node --watch-path=ontology scripts/generate-corpus-graph.mjs",
    "canon:generate": "node scripts/generate-canon.mjs",
    "canon:generate:ollama": "node scripts/generate-canon.mjs --ollama",
    "canon:check": "node scripts/check-canon-stale.mjs",
    "backup:nightly": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nightly-backup.ps1",
    "audit:windows-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-windows-dev-env.ps1",
    "solana:rpc": "node scripts/probe-solana-rpc.mjs",
    "solana:tx": "node --experimental-strip-types scripts/probe-solana-tx.ts",
    "eth:node-tokens": "node --experimental-strip-types scripts/probe-eth-tokens.ts",
    "test:solana-rpc": "node --experimental-strip-types --test src/lib/solana-rpc.test.ts",
    "test:solana-tx": "node --experimental-strip-types --test src/lib/solana-tx.test.ts src/lib/solana-wallet.test.ts",
    "test:eth-tokens": "node --experimental-strip-types --test src/lib/eth-tokens.test.ts",
    "test:oft": "node --experimental-strip-types --test src/lib/oft.test.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "^16.2.6",
    "postcss": "^8.5.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "unrs-resolver@1.12.2": true
  }
}
