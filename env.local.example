# Visible template (no leading dot, so Cursor and Explorer list it).
# Copy to .env.local — that file stays gitignored and hidden:
#   npm run env:local
# Then paste keys. Never commit .env.local. Never use NEXT_PUBLIC_* for these.

# https://developers.jup.ag/portal
JUPITER_API_KEY=

# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# Optional if PublicNode rate-limits the Solana probe:
# SOLANA_RPC_URL=
